# ==========================================================
# 配置文件模板：复制一份并重命名为 .env，再填入真实值
#   使用命令: cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交，真实密码只存在你本机
# ==========================================================

MYSQL_HOST=你的RDS连接地址
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的RDS密码
MYSQL_DATABASE=campus_master

REDIS_HOST=你的DCS实例连接地址
REDIS_PORT=6379
REDIS_PASSWORD=你的Redis密码

# ---- AI 大模型（华为云 MaaS，OpenAI 兼容接口）----
# 开通地址：华为云控制台 → 盘古模型服务/模型即服务 MaaS → 开通所需模型 → 创建 API Key
# 留空时代码自动降级为「本地规则引擎」，断网/无 Key 也能完整演示
MAAS_API_KEY=你的MaaS API Key
MAAS_MODEL=deepseek-v3-2324
MAAS_BASE_URL=https://api.cn-east-3.maas.com.cn/compatible-mode/v1
